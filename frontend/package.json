{
  "name": "frame-sequence",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "帧序本地视频增强工作台",
  "main": "desktop/main.cjs",
  "scripts": {
    "prestart": "npm run build",
    "start": "node desktop/launch.cjs",
    "desktop:dev": "node desktop/launch.cjs --dev",
    "runtime:prepare": "node desktop/prepare-runtime.cjs",
    "desktop:pack": "npm run build && npm run runtime:prepare && electron-builder --win dir --x64",
    "desktop:portable": "npm run build && npm run runtime:prepare && electron-builder --win portable --x64",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.framesequence.desktop",
    "productName": "帧序",
    "asar": true,
    "compression": "normal",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../desktop-release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/runtime.cjs",
      "desktop/media.cjs",
      "desktop/jobs.cjs",
      "desktop/queue.cjs",
      "desktop/icon.png",
      "package.json"
    ],
    "extraResources": [{ "from": ".cache/runtime", "to": "runtime" }],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "FrameSequence",
      "icon": "desktop/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "FrameSequence-${version}-Windows.exe"
    }
  }
}
